# Tento soubor zkopíruj na .env, jinak nebude fungovat Dev Container.
# (Není nutné klíče vyplňovat pokud je nepotřebuješ.)

# API klíč získej na: https://ppq.ai/api-docs
PPQ_API_KEY=

# Soukromá konfigurace synchronizace legacy Google kalendáře.
NUXT_GOOGLE_OAUTH_CLIENT_ID=
NUXT_GOOGLE_OAUTH_SECRET=
NUXT_GOOGLE_OAUTH_REFRESH_TOKEN=
NUXT_GOOGLE_LEGACY_CALENDAR_ID=
NUXT_EVENTS_ADMIN_TOKEN=
